{
  "name": "@marinade.finance/validator-bonds-cli-institutional",
  "version": "3.0.0",
  "description": "CLI of the validator bonds contract streamlined for institutional users",
  "repository": {
    "type": "git",
    "url": "git@github.com:marinade-finance/validator-bonds.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solana",
    "marinade.finance",
    "blockchain",
    "staking",
    "mnde"
  ],
  "author": "Marinade.Finance",
  "license": "ISC",
  "bin": {
    "validator-bonds-institutional": "./dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/",
    "!dist/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "cli": "pnpm ts-node ./src/",
    "test:validator": "pnpm jest --config ../../jest.config.test-validator.js --testPathPattern=\"$(pwd)\"",
    "test": "pnpm test:validator"
  },
  "dependencies": {
    "@coral-xyz/anchor": "npm:@anchor-lang/core@^1.2.1",
    "@ledgerhq/errors": "6.37.0",
    "@ledgerhq/hw-app-solana": "7.12.0",
    "@ledgerhq/hw-transport-node-hid-noevents": "6.36.0",
    "@marinade.finance/anchor-common": "5.11.1",
    "@marinade.finance/cli-common": "5.11.1",
    "@marinade.finance/ledger-utils": "3.2.1",
    "@marinade.finance/notifications-ts-subscription-client": "1.0.4",
    "@marinade.finance/ts-common": "5.11.1",
    "@marinade.finance/validator-bonds-cli-core": "workspace:*",
    "@marinade.finance/validator-bonds-sdk": "workspace:*",
    "@marinade.finance/web3js-1x": "5.11.1",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "commander": "14.0.3",
    "jsbi": "4.3.2",
    "pino": "9.14.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rpc-websockets": "9.3.10",
    "solana-spl-token-modern": "npm:@solana/spl-token@^0.3.11",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@marinade.finance/jest-shell-matcher": "1.1.3"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
