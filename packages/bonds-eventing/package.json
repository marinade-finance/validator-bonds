{
  "name": "@marinade.finance/bonds-eventing",
  "version": "0.0.1",
  "description": "Emit bond notification events after bonds collection",
  "repository": {
    "type": "git",
    "url": "git@github.com:marinade-finance/validator-bonds.git"
  },
  "bin": {
    "bonds-eventing": "./dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "private": true,
  "keywords": [
    "solana",
    "marinade.finance",
    "staking",
    "delegation"
  ],
  "files": [
    "dist/",
    "!dist/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "pretest": "node -e \"if (process.versions.node.split('.')[0] < 24) { console.error('Node.js 24 or higher is required (slonik is ESM-only and loaded with require)'); process.exit(1); }\"",
    "test": "jest --config jest.config.js --verbose",
    "cli": "pnpm ts-node ./src/index.ts"
  },
  "dependencies": {
    "@marinade.finance/cli-common": "5.12.2",
    "@marinade.finance/ds-sam-sdk": "0.6.10",
    "@marinade.finance/ts-common": "5.12.2",
    "@marinade.finance/validator-bonds-sdk": "workspace:*",
    "@marinade.finance/notifications-bonds-event-v1": "1.0.6",
    "@solana/web3.js": "1.99.0",
    "commander": "14.0.3",
    "pino": "9.14.0",
    "pino-pretty": "13.2.0",
    "slonik": "49.13.0",
    "uuid": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "reflect-metadata": "0.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
